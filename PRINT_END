[gcode_macro PRINT_END]
gcode:
    M400

    # ===== Clear Bed Mesh =====
    BED_MESH_CLEAR

    # ===== Cooling =====
    M140 S0
    M106 S255

    # ===== Retract =====
    M83
    G92 E0
    G2 I1 J0 Z{printer.toolhead.position.z + 0.5} E-1 F3000

    # ===== Lift Z =====
    G90
    {% if printer.toolhead.position.z > 50 %}
        G1 Z{printer.toolhead.position.z + 50} F20000
    {% else %}
        G1 Z100 F20000
    {% endif %}

    # ===== Move to tray =====
    M204 S5000
    M400
    G1 X202 F20000
    M400
    G1 Y250 F20000
    G1 Y264.5 F1200
    M400

    # ===== Shutdown =====
    G92 E0
    M104 S0
    M140 S0
    M106 S0
    M106 P2 S0
    M106 P3 S0

    M84

    # ===== Lights off =====
    SET_LED LED=case WHITE=0
